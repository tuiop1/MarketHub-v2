{
  "name": "markethub-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --port 3000 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --watch=false",
    "format": "prettier --write \"src/**/*.{ts,html,scss,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,md}\" \"*.{json,md}\""
  },
  "dependencies": {
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "keycloak-js": "^26.2.5",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.3.35",
    "@types/node": "^22.20.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.0",
    "typescript": "~5.8.0",
    "vitest": "^3.2.7"
  }
}
