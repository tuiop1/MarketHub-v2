{
	# TLS clients connecting to a literal IP may omit SNI. In that case Caddy
	# must still know which certificate to present.
	default_sni {$SERVER_IP}
}

https://{$SERVER_IP} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			email {$ACME_EMAIL}
			profile shortlived
		}
	}

	encode zstd gzip

	# Keycloak manages its own security headers. Keep the frontend headers away
	# from /auth so browser-based Keycloak flows are not blocked by DENY framing.
	@notKeycloak {
		not path /auth /auth/*
	}
	header @notKeycloak {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	redir /auth /auth/ 308

	# Keycloak listens at / inside the private Docker network. handle_path strips
	# the public /auth prefix before proxying it.
	handle_path /auth/* {
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Port 443
		}
	}

	handle /api/* {
		reverse_proxy gateway-service:8080
	}

	# Angular production assets are content-hashed and safe to cache forever.
	@staticAssets path_regexp staticAssets (?i)\.(?:js|css|woff2?|png|jpe?g|gif|svg|ico)$
	handle @staticAssets {
		root * /srv
		try_files {path} =404
		header Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx 304
		}
		file_server
	}

	# Everything else is either a real frontend file or an Angular client-side
	# route. Never cache the HTML shell so deployments are picked up immediately.
	handle {
		root * /srv
		header {
			Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
			Pragma no-cache
			Expires 0
		}
		try_files {path} {path}/ /index.html
		file_server
	}
}
