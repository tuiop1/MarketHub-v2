# Copy to production/aws/.env on EC2. This file contains examples, not credentials.
AWS_REGION=eu-central-1
ECR_REGISTRY=000000000000.dkr.ecr.eu-central-1.amazonaws.com
# Set to the Git commit SHA of the published Spring images before starting EC2.
RELEASE_TAG=configure-before-deploy

PUBLIC_APP_HOST=markethub-prod.xyz
ORIGIN_DOMAIN=origin.markethub-prod.xyz
ACME_EMAIL=your-email@example.com
# Generate with: openssl rand -hex 32. Set the same value on the CloudFront EC2 origin.
CLOUDFRONT_ORIGIN_SECRET=CHANGE_ME

RDS_HOST=replace-with-your-rds-endpoint.eu-central-1.rds.amazonaws.com
RDS_PORT=5432
ACCOUNT_DB_PASSWORD=CHANGE_ME
CATALOG_DB_PASSWORD=CHANGE_ME
CART_DB_PASSWORD=CHANGE_ME
ORDER_DB_PASSWORD=CHANGE_ME
PAYMENT_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Initial demo settings; measure before increasing load.
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:+ExitOnOutOfMemoryError
KEYCLOAK_HEAP=-Xms128m -Xmx512m
KAFKA_HEAP_OPTS=-Xms256m -Xmx384m
OTLP_TRACING_ENABLED=true
TRACING_SAMPLING_PROBABILITY=0.1
PROMETHEUS_RETENTION_TIME=24h
PROMETHEUS_RETENTION_SIZE=512MB
SENDGRID_API_KEY=disabled
SENDGRID_FROM_EMAIL=noreply@markethub-prod.xyz
SENDGRID_FROM_NAME=MarketHub

# RDS_ADMIN_USER / RDS_ADMIN_PASSWORD are used only for the one-time db-init tool.
# Supply them temporarily in the shell; do not give the application admin access.
